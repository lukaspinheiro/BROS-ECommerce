@inject BROS_ECommerce.Core.Interfaces.ITenantAtualService tenantService
@{
    var corFundo = tenantService.TenantAtual?.CorFundo;
    var nomeLoja = tenantService.TenantAtual?.Nome;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | @nomeLoja</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="~/css/Carrinho/carrinho-sidebar.css" rel="stylesheet" />
    <link href="~/css/Carrinho/carrinho-toast.css" rel="stylesheet" />
    <link href="~/css/Produto/produto-carrinho-integration.css" rel="stylesheet" />
    <link href="~/css/shared/carrinho-icon-fix.css" rel="stylesheet" />
    <link href="~/css/shared/toast.css" rel="stylesheet" />

    <partial name="\PartialsLayout\_ReferenciasCss" />

    @RenderSection("Head", required: false)
    @RenderSection("styles", required: false)

    @Html.AntiForgeryToken()
</head>
<body style="background-color: @corFundo;">
    <header>
        <partial name="\PartialsLayout\_NavbarAcessibilidade" />
        <partial name="\PartialsLayout\_NavbarSuperior" />
        <partial name="\PartialsLayout\_NavbarInferior" />
    </header>

    <main role="main" class="pb-3 paddingX">
        @RenderBody()
    </main>

    <footer>
        <div class="w-100">
            <partial name="\PartialsLayout\_FooterSuperior" />
            <partial name="\PartialsLayout\_FooterInferior" />
        </div>
    </footer>

    <partial name="\PartialsLayout\_ReferenciasScript" />
    <partial name="PartialsLayout/_CarrinhoSidebar" />

    <script src="~/js/shared/carrinho-sidebar.js"></script>
    <script src="~/js/shared/carrinho.js"></script>
    <script src="~/js/shared/toast.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>