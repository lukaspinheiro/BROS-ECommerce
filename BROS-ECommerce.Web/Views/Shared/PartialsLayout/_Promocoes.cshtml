@model BROS_ECommerce.Services.ViewModel.Home.HomeViewModel

<section class="promocao-section">
    <h2 class="text-center extra-bold mb-4">EM PROMOÇÃO</h2>
    <div class="carousel-wrapper">
        <button class="scroll-btn left" id="btn-left">‹</button>
        <div class="produtos-container d-flex justify-content-between gap-5" id="carousel">

            @foreach (var promo in Model.Promocoes)
            {
                <div class="card d-flex justify-content-between">
                    <div class="d-flex justify-content-center align-items-center imagem-produto">
                        <img src="@promo.ImagemProduto" alt="@promo.NomeProduto" />
                    </div>
                    <div class="desconto extra-bold">@promo.PercentualDesconto.ToString("F0")% OFF</div>
                    <div class="descricao fw-bolder">@promo.NomeProduto</div>
                    <div class="precos">
                        <del>De R$ @promo.PrecoOriginal.ToString("F2")</del>
                        <strong>POR R$ @promo.PrecoPromocional.ToString("F2")</strong>
                    </div>
                    <button class="btn-comprar" onclick="adicionarAoCarrinho('@promo.IdProduto')">COMPRAR</button>
                </div>
            }

        </div>
        <button class="scroll-btn right" id="btn-right">›</button>
    </div>
</section>
