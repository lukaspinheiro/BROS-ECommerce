@model IEnumerable<BROS_ECommerce.Services.ViewModel.Produto.TabelaProdutoViewModel>
@inject BROS_ECommerce.Core.Interfaces.ITenantAtualService tenantService
@{
    var corTextoFundo = tenantService.TenantAtual?.CorTexto;
    var corSeta = tenantService.TenantAtual?.CorFundo;
}

    <section class="promocao-section">
        <h2 class="text-center extra-bold mb-4" style="color: @corTextoFundo;">Produtos</h2>
        <div class="carousel-wrapper">
            <button class="scroll-btn left" id="btn-left" style="background-color: @corTextoFundo; color: @corSeta;">‹</button>
            <div class="produtos-container d-flex justify-content-between gap-5" id="carousel">

                @if (Model != null && Model.Any())
                {
                    @foreach (var produto in Model)
                    {
                        <div class="card d-flex justify-content-between">
                            <div class="d-flex justify-content-center align-items-center imagem-produto">
                                @if (produto.TemImagem)
                                {
                                    <img src="@produto.ImagemPrincipal"
                                         alt="@produto.Nome" />
                                }
                                else
                                {
                                    <div style="max-width: 100%; max-height: 100%; background-color: #f8f9fa; border: 1px dashed #dee2e6; display: flex; align-items: center; justify-content: center; border-radius: 4px;">
                                        <i class="fas fa-image text-muted"></i>
                                    </div>
                                }
                            </div>
                            <div class="desconto extra-bold">Compre já</div>
                            <div class="descricao fw-bolder">@produto.Nome</div>
                            <div class="precos">
                                @* <del>De R$ 138,80</del> *@
                                <strong>POR R$ @produto.Preco</strong>
                            </div>
                            <button class="btn-comprar" onclick="adicionarAoCarrinho('@produto.IdProduto')">COMPRAR</button>
                        </div>
                    }
                }
                else
                {
                    <div class="card d-flex justify-content-between">
                        <div class="d-flex justify-content-center align-items-center imagem-produto">
                            <div style="max-width: 100%; max-height: 100%; background-color: #f8f9fa; border: 1px dashed #dee2e6; display: flex; align-items: center; justify-content: center; border-radius: 4px;">
                                <i class="fas fa-image text-muted"></i>
                            </div>
                        </div>
                        <div class="desconto extra-bold">Compre já</div>
                        <div class="descricao fw-bolder">Produto padrão 1</div>
                        <div class="precos">
                            @* <del>De R$ 138,80</del> *@
                            <strong>POR R$ 20,00</strong>
                        </div>
                        <button class="btn-comprar" disabled>COMPRAR</button>
                    </div>
                }

            </div>
            <button class="scroll-btn right" id="btn-right" style="background-color: @corTextoFundo; color: @corSeta;">›</button>
        </div>
    </section>