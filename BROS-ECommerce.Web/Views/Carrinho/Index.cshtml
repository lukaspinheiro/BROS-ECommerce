@model BROS_ECommerce.Services.ViewModel.Carrinho.CarrinhoViewModel
@{
    ViewData["Title"] = "Carrinho de Compras";
}

@section Head {
    <link href="~/css/Carrinho/carrinho.css" rel="stylesheet" />
}

<div class="carrinho-page">
    <div class="carrinho-container">
        <div class="carrinho-header">
            <h2 class="carrinho-titulo">
                <i class="fa-solid fa-cart-shopping me-3"></i>
                CARRINHO (@(Model?.QuantidadeTotal ?? 0))
            </h2>
        </div>

        @if (Model == null || !Model.TemItens)
        {
            <div class="carrinho-vazio">
                <div class="carrinho-vazio-content">
                    <div class="carrinho-vazio-icon">
                        <i class="fa-solid fa-cart-shopping"></i>
                    </div>
                    <h3>Seu carrinho ainda está vazio</h3>
                    <p>Que tal conferir algumas ofertas e produtos dos Gymbros?</p>
                    <div class="carrinho-vazio-actions">
                        <a href="/" class="btn-continuar-comprando">
                            Continuar comprando
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="carrinho-com-produtos">
                <div class="row">
                    <div class="col-lg-8 col-md-12">
                        <div class="carrinho-itens">
                            @foreach (var item in Model.Itens)
                            {
                                <div class="carrinho-item" data-produto-id="@item.IdProduto">
                                    <div class="item-imagem">
                                        <img src="@(item.ImagemUrl ?? "/images/produto-sem-imagem.png")" alt="@item.Nome" />
                                    </div>

                                    <div class="item-detalhes">
                                        <h4 class="item-nome">@item.Nome</h4>
                                        <div class="item-preco">@item.PrecoFormatado</div>
                                    </div>

                                    <div class="item-quantidade">
                                        <button class="btn-quantidade btn-menos" onclick="alterarQuantidadeSegura('@item.IdProduto', 'menos')"
                                                @(item.Quantidade <= 1 ? "disabled" : "") data-produto-id="@item.IdProduto">
                                            <i class="fa-solid fa-minus"></i>
                                        </button>
                                        <span class="quantidade-valor">@item.Quantidade</span>
                                        <button class="btn-quantidade btn-mais" onclick="alterarQuantidadeSegura('@item.IdProduto', 'mais')"
                                                data-produto-id="@item.IdProduto">
                                            <i class="fa-solid fa-plus"></i>
                                        </button>
                                    </div>

                                    <div class="item-subtotal">
                                        R$ @item.Subtotal.ToString("F2")
                                    </div>

                                    <div class="item-acoes">
                                        <button class="btn-remover" onclick="removerItem('@item.IdProduto')"
                                                title="Remover produto">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="carrinho-acoes">
                            <a href="/" class="btn-continuar-comprando">
                                <i class="fa-solid fa-arrow-left me-2"></i>
                                Continuar comprando
                            </a>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-12">
                        <div class="carrinho-resumo">
                            <h3>Resumo do Pedido</h3>

                            <div class="resumo-linha">
                                <span>Quantidade de itens:</span>
                                <span id="resumo-quantidade">@Model.QuantidadeTotal</span>
                            </div>

                            <div class="resumo-linha">
                                <span>Subtotal:</span>
                                <span id="resumo-subtotal">R$ @Model.ValorTotal.ToString("F2")</span>
                            </div>

                            <div class="resumo-linha">
                                <span>Frete:</span>
                                <span>A calcular</span>
                            </div>

                            <div class="resumo-linha resumo-total">
                                <span>Total:</span>
                                <span id="resumo-total">R$ @Model.ValorTotal.ToString("F2")</span>
                            </div>

                            <div class="carrinho-checkout">
                                <button class="btn-finalizar-compra" onclick="finalizarCompra()">
                                    <i class="fa-solid fa-credit-card me-2"></i>
                                    Finalizar Compra
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/Carrinho/carrinho-page.js"></script>
}