<div class="checkout-summary">
    <h3>
        <i class="fa-solid fa-receipt me-2"></i>
        Resumo do Pedido
    </h3>

    <div class="summary-loading" id="summary-loading" style="display: none;">
        <div class="d-flex align-items-center justify-content-center py-4">
            <i class="fa-solid fa-spinner fa-spin me-2"></i>
            <span>Carregando dados do carrinho...</span>
        </div>
    </div>

    <div class="summary-content" id="summary-content">
        <!-- Lista de produtos -->
        <div class="products-list" id="products-list">
            <h5 class="products-title">
                <i class="fa-solid fa-shopping-bag me-2"></i>
                Produtos no Carrinho
            </h5>
            <div class="products-container" id="products-container">
                <!-- Os produtos serão carregados aqui via JavaScript -->
            </div>
        </div>

        <!-- Totais -->
        <div class="summary-totals">
            <div class="summary-item">
                <div class="d-flex justify-content-between">
                    <span>Quantidade de itens:</span>
                    <span data-resumo="quantidade" class="resumo-quantidade">-</span>
                </div>
            </div>

            <div class="summary-item">
                <div class="d-flex justify-content-between">
                    <span>Subtotal:</span>
                    <span data-resumo="subtotal" class="resumo-subtotal">R$ 0,00</span>
                </div>
            </div>

            <div class="summary-item">
                <div class="d-flex justify-content-between text-muted">
                    <span>Frete:</span>
                    <span data-resumo="frete" class="resumo-frete">A calcular</span>
                </div>
                <small class="text-muted">O frete será calculado após inserir o endereço</small>
            </div>

            <div class="summary-total">
                <div class="d-flex justify-content-between fw-bold">
                    <span>Total:</span>
                    <span data-resumo="total" class="resumo-total">R$ 0,00</span>
                </div>
            </div>
        </div>

        <div class="summary-actions">
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.CheckoutCarrinho?.recarregarCarrinho()">
                <i class="fa-solid fa-refresh me-2"></i>
                Atualizar Carrinho
            </button>
        </div>
    </div>

    <div class="summary-empty" id="summary-empty" style="display: none;">
        <div class="text-center py-4">
            <i class="fa-solid fa-cart-shopping fa-2x text-muted mb-3"></i>
            <p class="text-muted mb-3">Seu carrinho está vazio</p>
            <a href="/" class="btn btn-primary">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Continuar Comprando
            </a>
        </div>
    </div>
</div>

