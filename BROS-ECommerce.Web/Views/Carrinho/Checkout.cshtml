@{
    ViewData["Title"] = "Finalizar Compra";
}

@section Head {
    <link href="~/css/Checkout/checkout.css" rel="stylesheet" />
}

<div class="checkout-container">
    <div class="checkout-header">
        <h2>
            <i class="fa-solid fa-credit-card me-3"></i>
            Finalizar Compra
        </h2>
        <p>Complete os dados abaixo para finalizar sua compra</p>
    </div>

    <div class="checkout-content">
        <div class="row">
            <div class="col-lg-8">
                <div class="checkout-section">
                    <h3>Dados de Entrega</h3>
                    <div class="implementation-placeholder">
                        <div class="placeholder-icon">
                            <i class="fa-solid fa-code"></i>
                        </div>
                        <h4>Zona de pagamento</h4>
                        <p>Área de pagamento.</p>
                        <ul class="implementation-list">
                            <li>Formulário de endereço</li>
                        </ul>
                    </div>
                </div>

                <form id="form-finalizar-pedido" method="post" action="/pagamento/iniciar">
                    <div class="checkout-section">
                        <h3>Forma de Pagamento</h3>

                        <div class="payment-option">
                            <label for="stripe">
                                <input type="radio" name="metodo" id="stripe" value="stripe" />
                                <span>Stripe</span>
                            </label>
                        </div>

                        <div class="payment-option">
                            <label for="mercadopago">
                                <input type="radio" name="metodo" id="mercadopago" value="mercadopago" />
                                <span>MercadoPago</span>
                            </label>
                        </div>
                    </div>

                    <div class="checkout-actions">
                        <a href="/Carrinho" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-arrow-left me-2"></i>
                            Voltar ao Carrinho
                        </a>
                        <button id="btn-finalizar" class="btn btn-success btn-lg" type="submit">
                            <i class="fa-solid fa-lock me-2"></i>
                            Finalizar Pedido
                        </button>
                    </div>
                </form>
            </div>

            <div class="col-lg-4">
                <div class="checkout-summary">
                    <h3>Resumo do Pedido</h3>
                    <div class="summary-placeholder">
                        <div class="summary-item">
                            <div class="d-flex justify-content-between">
                                <span>Subtotal:</span>
                                <span>R$ XXX,XX</span>
                            </div>
                        </div>
                        <div class="summary-item">
                            <div class="d-flex justify-content-between">
                                <span>Frete:</span>
                                <span>A calcular</span>
                            </div>
                        </div>
                        <hr>
                        <div class="summary-total">
                            <div class="d-flex justify-content-between fw-bold">
                                <span>Total:</span>
                                <span>R$ XXX,XX</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("form-finalizar-pedido").addEventListener("submit", function (e) {
            const selected = document.querySelector('input[name="metodo"]:checked');
            if (!selected) {
                e.preventDefault();
                alert("Selecione uma forma de pagamento antes de continuar.");
            }
        });
    </script>
}
