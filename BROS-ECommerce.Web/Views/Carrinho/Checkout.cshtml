@{
    ViewData["Title"] = "Finalizar Compra";
}

@section Head {
    <link href="~/css/Checkout/checkout.css" rel="stylesheet" />
}

<div class="checkout-container">
    <div class="checkout-header">
        <h2>
            <i class="fa-solid fa-credit-card me-3"></i>
            Finalizar Compra
        </h2>
        <p>Complete os dados abaixo para finalizar sua compra</p>
    </div>

    <div class="checkout-content">
        <div class="row">
            <div class="col-lg-8">
               
                <div class="checkout-section">
                    <h3>Dados de Entrega</h3>
                    <div class="implementation-placeholder">
                        <div class="placeholder-icon">
                            <i class="fa-solid fa-code"></i>
                        </div>
                        <h4>Área de Implementação</h4>
                        <p>Esta seção será implementada pelo responsável pela tela de pagamento.</p>
                        <ul class="implementation-list">
                            <li>Formulário de endereço</li>
                            <li>Opções de entrega</li>
                            <li>Dados de pagamento</li>
                            <li>Confirmação do pedido</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                
                <div class="checkout-summary">
                    <h3>Resumo do Pedido</h3>
                    <div class="summary-placeholder">
                        <div class="d-flex justify-content-between">
                            <span>Subtotal:</span>
                            <span>R$ XXX,XX</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Frete:</span>
                            <span>A calcular</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between fw-bold">
                            <span>Total:</span>
                            <span>R$ XXX,XX</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="checkout-actions">
        <a href="/Carrinho" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Voltar ao Carrinho
        </a>
    </div>
</div>