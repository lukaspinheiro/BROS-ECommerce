@{
    ViewData["Title"] = "Finalizar Compra";
}

@section Head {
    <link href="~/css/Checkout/checkout.css" rel="stylesheet" />
    <link href="~/css/Checkout/checkout-user-data.css" rel="stylesheet" />
}

<div class="checkout-container">
    @Html.AntiForgeryToken()

    <div class="checkout-header">
        <h2>
            <i class="fa-solid fa-credit-card me-3"></i>
            Finalizar Compra
        </h2>
        <p>Complete os dados abaixo para finalizar sua compra</p>
    </div>

    <div class="checkout-progress">
        <div class="progress-step active" data-step="1">
            <div class="step-icon">
                <i class="fa-solid fa-user"></i>
            </div>
            <span>Contato</span>
        </div>
        <div class="progress-step" data-step="2">
            <div class="step-icon">
                <i class="fa-solid fa-map-marker-alt"></i>
            </div>
            <span>Endereço</span>
        </div>
        <div class="progress-step" data-step="3">
            <div class="step-icon">
                <i class="fa-solid fa-credit-card"></i>
            </div>
            <span>Pagamento</span>
        </div>
    </div>

    <div class="checkout-content">
        <div class="row">
            <div class="col-lg-8">
                <div class="checkout-tabs">
                    <div class="tab-content active" id="tab-contato">
                        <div class="checkout-section">
                            <h3>
                                <i class="fa-solid fa-user me-2"></i>
                                Dados de Contato
                            </h3>
                            <partial name="Partials/_FormularioContato" />
                        </div>
                    </div>

                    <div class="tab-content" id="tab-endereco">
                        <div class="checkout-section">
                            <h3>
                                <i class="fa-solid fa-map-marker-alt me-2"></i>
                                Endereço de Entrega
                            </h3>
                            <partial name="Partials/_FormularioEndereco" />
                        </div>
                    </div>

                    <div class="tab-content" id="tab-pagamento">
                        <div class="checkout-section">
                            <h3>
                                <i class="fa-solid fa-credit-card me-2"></i>
                                Forma de Pagamento
                            </h3>
                            <form id="form-finalizar-pedido" method="post" action="/pagamento/iniciar">
                                <div class="payment-methods">
                                    <div class="payment-option">
                                        <input type="radio" name="metodo" id="stripe" value="stripe" class="payment-radio">
                                        <label for="stripe" class="payment-label">
                                            <div class="payment-icon">
                                                <i class="fa-brands fa-stripe"></i>
                                            </div>
                                            <div class="payment-info">
                                                <span class="payment-name">Stripe</span>
                                                <small class="payment-desc">Cartão de crédito/débito</small>
                                            </div>
                                        </label>
                                    </div>

                                    <div class="payment-option">
                                        <input type="radio" name="metodo" id="mercadopago" value="mercadopago" class="payment-radio">
                                        <label for="mercadopago" class="payment-label">
                                            <div class="payment-icon">
                                                <i class="fa-solid fa-credit-card"></i>
                                            </div>
                                            <div class="payment-info">
                                                <span class="payment-name">MercadoPago</span>
                                                <small class="payment-desc">PIX, Cartão, Boleto</small>
                                            </div>
                                        </label>
                                    </div>
                                </div>

                                <div class="form-actions">
                                    <button type="button" id="btn-voltar-endereco" class="btn btn-outline-secondary">
                                        <i class="fa-solid fa-arrow-left me-2"></i>
                                        Voltar ao Endereço
                                    </button>
                                    <button type="submit" id="btn-finalizar-pedido" class="btn btn-success btn-lg">
                                        <i class="fa-solid fa-lock me-2"></i>
                                        Finalizar Pedido
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <partial name="Partials/_ResumoCheckout" />
            </div>
        </div>
    </div>

    <div class="checkout-actions-mobile">
        <button id="btn-voltar-carrinho" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Voltar ao Carrinho
        </button>
        <button id="btn-proximo-passo" class="btn btn-primary btn-lg">
            <span class="btn-text">Próximo Passo</span>
            <i class="fa-solid fa-arrow-right ms-2"></i>
        </button>
    </div>
</div>

@section Scripts {
    <script src="~/js/Checkout/checkout-carrinho.js"></script>
    <script src="~/js/Checkout/checkout-user-data.js"></script>
    <script src="~/js/Checkout/checkout-frete.js"></script>
    <script src="~/js/Checkout/checkout.js"></script>
}