@model BROS_ECommerce.Services.ViewModel.Produto.ProdutoViewModel;
@{
    ViewData["Title"] = Model.Nome;
}
@section Head{
    <link href="~/css/Shared/promocoes.css" rel="stylesheet" />
    <link href="/css/Produto/index.css" rel="stylesheet" />
}

<div class="produto-detalhes-container mt-5 align-items-center">
    <div class="produto-descricao">
        <p class="fs-4">@Model.TituloDescricao</p>
        <p>@Model.Descricao</p>
    </div>

    <div class="produto-imagens position-relative">
        @if (Model.Imagens != null && Model.Imagens.Any())
        {
            var primeiro = true;
            <div id="carouselProduto" class="carousel slide" data-ride="carousel">

                <div class="carousel-inner rounded-4">
                    @foreach (var imagem in Model.Imagens)
                    {
                        <div class="carousel-item @(primeiro ? "active" : "")">
                            <img src="@imagem" alt="@Model.Nome" class="d-block w-100" style="max-height: 400px; object-fit: cover;" />
                        </div>
                        primeiro = false;
                    }
                </div>

                @if (Model.Imagens.Count > 1)
                {
                    <button class="scroll-btn-produto left" data-target="#carouselProduto" data-slide="prev">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <button class="scroll-btn-produto right" data-target="#carouselProduto" data-slide="next">
                        <i class="fas fa-chevron-right"></i>
                    </button>

                    <ol class="carousel-indicators">
                        @for (int i = 0; i < Model.Imagens.Count; i++)
                        {
                            <li data-target="#carouselProduto" data-slide-to="@i" class="@(i == 0 ? "active" : "")"></li>
                        }
                    </ol>
                }
            </div>
        }
        else
        {
            <div class="bg-light d-flex align-items-center justify-content-center rounded-4" style="height: 400px;">
                <div class="text-center">
                    <i class="fas fa-image fa-4x text-muted mb-3"></i>
                    <p class="text-muted">Imagem não disponível</p>
                </div>
            </div>
        }
    </div>

    <div class="produto-compra">
        <div class="preco-container">
            <span class="preco-atual">@Model.Preco.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span>
        </div>

        <div class="desconto-pix">
            <span class="badge badge-success">10% OFF no PIX</span>
        </div>

        <div class="botoes-acao mt-3">
            <button class="btn btn-primary btn-lg btn-block">
                <i class="fas fa-shopping-cart"></i> COMPRAR AGORA
            </button>
            
            <button class="btn btn-outline-primary btn-lg btn-block mt-2">
                <i class="fas fa-heart"></i> ADICIONAR AOS FAVORITOS
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            @if (Model.Imagens?.Count > 1)
            {
                <text>
                $('#carouselProduto').carousel({
                    interval: 5000,
                    ride: 'carousel'
                });
                </text>
            }
        });
    </script>
}