@model BROS_ECommerce.Services.ViewModel.Produto.ProdutoViewModel;
@{
    ViewData["Title"] = Model.Nome;
}
@section Head{
    <head>
        <link href="~/css/Shared/promocoes.css" rel="stylesheet" />
<style>
    .produto-detalhes-container {
        display: flex;
        gap: 2rem;
        align-items: flex-start;
    }

    .produto-descricao {
        flex: 1;
        max-width: 30%;
    }

    .produto-imagens {
        flex: 1;
        text-align: center;
    }

        .produto-imagens img {
            max-width: 100%;
            border-radius: 8px;
            margin-bottom: 1rem;
            max-height: 30rem;
        }

    .produto-compra {
        flex: 1;
        max-width: 30%;
        border-radius: 8px;
    }

        .produto-compra .marca {
            font-size: 0.9rem;
        }

        .produto-compra .preco {
            font-size: 1.5rem;
            font-weight: bold;
            color: red;
        }

    .frete {
        margin-top: 1rem;
                display: inline;
    }

        .frete input {
            padding: 0.5rem;
        }
        .produto-compra .btn-comprar{
            margin: unset;
            border: unset;
        }

            .scroll-btn-produto {
                background-color: #343A40;
                color: white;
                border: none;
                font-size: 1.5rem;
                cursor: pointer;
                padding: 0;
                width: 40px;
                height: 40px;
                border-radius: 50%;
                z-index: 10;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 2px 5px rgba(0,0,0,0.2);
                transition: background 0.3s;
            }

                .scroll-btn-produto:hover {
                    background-color: #e94a50;
                }

            .scroll-btn-produto.left {
                    position: absolute;
                    left: 0rem;
                    top: 50%;
                    transform: translateY(-50%);
                }

                .scroll-btn-produto.right {
                    position: absolute;
                    right: 0rem;
                    top: 50%;
                    transform: translateY(-50%);
                }

</style>
    </head>
}

<div class="produto-detalhes-container mt-5 align-items-center">
    <div class="produto-descricao">
        <p class="fs-4">@Model.TituloDescricao</p>
        <p>@Model.Descricao</p>
    </div>

    <div class="produto-imagens position-relative">
        @if (Model.Imagens != null && Model.Imagens.Any())
        {
            var primeiro = true;
            <div id="carouselProduto" class="carousel slide" data-ride="carousel">

                <div class="carousel-inner rounded-4">
                    @foreach (var imagem in Model.Imagens)
                    {
                        <div class="carousel-item @(primeiro ? "active" : "")">
                            <img src="@imagem" alt="@Model.Nome" />
                        </div>
                        primeiro = false;
                    }
                </div>

                <button class="scroll-btn-produto left" data-target="#carouselProduto" data-slide="prev">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button class="scroll-btn-produto right" data-target="#carouselProduto" data-slide="next">
                    <i class="fas fa-chevron-right"></i>
                </button>

                <ol class="carousel-indicators">
                    @for (int i = 0; i < Model.Imagens.Count; i++)
                    {
                        <li data-target="#carouselProduto" data-slide-to="@i" class="@(i == 0 ? "active" : "")"></li>
                    }
                </ol>
            </div>
        }
    </div>

    <div class="produto-compra">
        <div class="text-end">
            <p class="marca mb-0">Gymbros Suplemments</p>
            <h3 class="fw-bolder mt-0 mb-lg-5">@Model.Nome</h3>
            <p class="preco">R$@Model.Preco.ToString("F2")</p>
            <p class="parcelamento">ou R$@((Model.Preco * 1.02m / 6).ToString("F2")) em até 6x sem juros</p>
        </div>
        <div class="frete row w-100">
            
            <p class="fw-bold px-0">Calcule o frete</p>
            <form class="d-flex bg-light rounded-2 w-100 p-0">
                <input class="flex-fill form-control border border-secondary" style="height: 2.5rem;" type="text" placeholder="CEP" />
                <button class="bg-secondary-subtle border border-secondary">Calcular</button>
            </form>
            <button class="btn-comprar mt-5">
                Comprar
                <i class="fas fa-shopping-cart" style="margin-left: 5px;"></i>
            </button>
        </div>
    </div>
</div>

<partial name="\PartialsLayout\_Promocoes" />

@section scripts{
    <script src="~/js/shared/promocoes.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#carouselExampleIndicators').carousel({
                interval: 5000,
                pause: 'hover',
                wrap: true
            });
        });
    </script>
}