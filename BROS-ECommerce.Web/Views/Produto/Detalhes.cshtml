@model BROS_ECommerce.Services.ViewModel.Produto.ProdutoViewModel;

@{
    ViewData["Title"] = Model.Nome;
}

@section Head {
    <link href="~/css/Shared/promocoes.css" rel="stylesheet" />
    <link href="~/css/Produto/index.css" rel="stylesheet" />
}

<div class="produto-detalhes-container mt-5 align-items-start">
    <!-- COLUNA: Descrição -->
    <div class="produto-descricao">
        <p class="fs-4">@Model.TituloDescricao</p>
        <p>@Model.Descricao</p>
    </div>

    <!-- COLUNA: Imagens -->
    <div class="produto-imagens position-relative">
        @if (Model.Imagens != null && Model.Imagens.Any())
        {
            var primeiro = true;
            <div id="carouselProduto" class="carousel slide" data-ride="carousel">
                <div class="carousel-inner rounded-4">
                    @foreach (var imagem in Model.Imagens)
                    {
                        <div class="carousel-item @(primeiro ? "active" : "")">
                            <img src="@imagem" alt="@Model.Nome" />
                        </div>
                        primeiro = false;
                    }
                </div>

                <button class="scroll-btn-produto left" data-target="#carouselProduto" data-slide="prev">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button class="scroll-btn-produto right" data-target="#carouselProduto" data-slide="next">
                    <i class="fas fa-chevron-right"></i>
                </button>

                <ol class="carousel-indicators">
                    @for (int i = 0; i < Model.Imagens.Count; i++)
                    {
                        <li data-target="#carouselProduto" data-slide-to="@i" class="@(i == 0 ? "active" : "")"></li>
                    }
                </ol>
            </div>
        }
    </div>

    <!-- COLUNA: Compra + CEP -->
    <div class="produto-compra">
        <div class="text-end">
            <p class="marca mb-0">Gymbros Suplemments</p>
            <h3 class="fw-bolder mt-0 mb-lg-5">@Model.Nome</h3>
            <p class="preco">R$@Model.Preco.ToString("F2")</p>
            <p class="parcelamento">ou R$@((Model.Preco * 1.02m / 6).ToString("F2")) em até 6x sem juros</p>
        </div>

        <div class="frete row w-100">
            <button class="btn-finalizar" onclick="adicionarProdutoCarrinho('@Model.IdProduto')" id="btn-adicionar-carrinho">
                <span class="btn-text">Finalizar compra</span>
                <i class="fas fa-cart-plus btn-icon"></i>
                <div class="btn-loader" style="display: none;">
                    <i class="fas fa-spinner fa-spin"></i>
                </div>
            </button>

            <p class="d-flex justify-content-start fw-bold mt-5 mb-2">Calcule o frete</p>

            <form id="freteForm" class="d-flex justify-content-center align-items-center px-0 w-100">
                <div class="input-group">
                    <input id="cepInput"
                           class="form-control border border-2 rounded-3 py-2"
                           type="text"
                           placeholder="Digite seu CEP"
                           maxlength="9"
                           pattern="[0-9]{5}-?[0-9]{3}">
                    <button type="submit"
                            id="calcularBtn"
                            class="btn btn-success fw-semibold rounded-3 px-4 py-2">
                        <i class="fas fa-truck me-2"></i> Calcular
                    </button>
                </div>
            </form>

            <div id="enderecoInfo" class="mt-3" style="display: none;">
                <div class="card border-success">
                    <div class="card-body">
                        <h6 class="card-title text-success">
                            <i class="fas fa-map-marker-alt me-2"></i>Endereço encontrado:
                        </h6>
                        <p class="card-text mb-1">
                            <strong>Logradouro:</strong> <span id="logradouro"></span>
                        </p>
                        <p class="card-text mb-1">
                            <strong>Bairro:</strong> <span id="bairro"></span>
                        </p>
                        <p class="card-text mb-1">
                            <strong>Cidade:</strong> <span id="localidade"></span> - <span id="uf"></span>
                        </p>
                        <p class="card-text mb-0">
                            <strong>CEP:</strong> <span id="cepFormatado"></span>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="\PartialsLayout\_Promocoes" />

@section Scripts {
    <script src="~/js/shared/promocoes.js"></script>
    <script src="~/js/Produto/frete.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#carouselProduto').carousel({
                interval: 5000,
                pause: 'hover',
                wrap: true
            });
        });

        async function adicionarProdutoCarrinho(produtoId) {
            const btn = document.getElementById('btn-adicionar-carrinho');
            const btnText = btn.querySelector('.btn-text');
            const btnIcon = btn.querySelector('.btn-icon');
            const btnLoader = btn.querySelector('.btn-loader');

            try {
                console.log('Tentando adicionar produto:', produtoId);

                btn.disabled = true;
                btn.classList.add('loading');
                if (btnText) btnText.style.display = 'none';
                if (btnIcon) btnIcon.style.display = 'none';
                if (btnLoader) btnLoader.style.display = 'inline-block';

                if (window.CarrinhoSidebar) {
                    console.log('Usando CarrinhoSidebar');
                    await window.CarrinhoSidebar.adicionarProduto(produtoId, 1);

                    btn.classList.add('success');
                    setTimeout(() => btn.classList.remove('success'), 800);

                } else {
                    
                    console.warn('CarrinhoSidebar não encontrado, usando método tradicional');
                    await adicionarProdutoTradicional(produtoId);
                }

            } catch (error) {
                console.error('Erro ao adicionar produto:', error);

                
                if (window.CarrinhoSidebar && window.CarrinhoSidebar.mostrarFeedback) {
                    window.CarrinhoSidebar.mostrarFeedback('Erro ao adicionar produto ao carrinho', 'error');
                } else {
                    alert('Erro ao adicionar produto ao carrinho: ' + error.message);
                }
            } finally {
                
                setTimeout(() => {
                    btn.disabled = false;
                    btn.classList.remove('loading');
                    if (btnText) btnText.style.display = 'inline';
                    if (btnIcon) btnIcon.style.display = 'inline';
                    if (btnLoader) btnLoader.style.display = 'none';
                }, 500);
            }
        }

        
        async function adicionarProdutoTradicional(produtoId) {
            console.log('Usando método tradicional para produto:', produtoId);

            const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenElement ? tokenElement.value : '';

            const response = await fetch('/Carrinho/AdicionarProduto', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `produtoId=${produtoId}&quantidade=1`
            });

            if (!response.ok) {
                throw new Error('Erro na requisição: ' + response.status);
            }

            const result = await response.json();
            console.log('Resultado da requisição:', result);

            if (result.sucesso) {
                
                if (confirm('Produto adicionado! Deseja ir para o carrinho?')) {
                    window.location.href = '/Carrinho';
                }
            } else {
                throw new Error(result.mensagem || 'Erro desconhecido');
            }
        }

        
        window.adicionarAoCarrinho = async function(produtoId, quantidade = 1) {
            return await adicionarProdutoCarrinho(produtoId);
        };
    </script>
}