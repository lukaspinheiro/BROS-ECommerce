@using BROS_ECommerce.Services.ViewModel.Pedido

@{
    ViewData["Title"] = "Pedido Confirmado";
    var ultimoPedido = ViewBag.UltimoPedido as TabelaPedidoViewModel;
}

@section Head {
    <style>
        .success-container {
            text-align: center;
            padding: 3rem 0;
        }

        .success-icon {
            color: #28a745;
            font-size: 4rem;
            margin-bottom: 1rem;
        }

        .success-card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .pedido-info {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 1.5rem;
            margin: 1rem 0;
        }
    </style>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card success-card">
                <div class="card-body success-container">
                    <div class="success-icon">
                        <i class="fa-solid fa-check-circle"></i>
                    </div>

                    <h1 class="text-success mb-3">Pedido Confirmado!</h1>
                    <p class="lead text-muted">Seu pagamento foi processado com sucesso.</p>

                    @if (ultimoPedido != null)
                    {
                        <div class="pedido-info">
                            <h4>Detalhes do Pedido</h4>
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>Número do Pedido:</strong><br>
                                    <span class="h5 text-primary">@ultimoPedido.NumeroPedido</span>
                                </div>
                                <div class="col-md-6">
                                    <strong>Valor Total:</strong><br>
                                    <span class="h5 text-success">@ultimoPedido.ValorTotalFormatado</span>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <strong>Data:</strong><br>
                                    @ultimoPedido.DataPedidoFormatada
                                </div>
                                <div class="col-md-6">
                                    <strong>Status:</strong><br>
                                    <span class="badge bg-@ultimoPedido.StatusCor">@ultimoPedido.StatusFormatado</span>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="alert alert-info mt-4">
                        <i class="fa-solid fa-info-circle me-2"></i>
                        <strong>Próximos Passos:</strong><br>
                        Você receberá um email de confirmação com todos os detalhes do seu pedido.
                        Acompanhe o status na área "Meus Pedidos".
                    </div>

                    <div class="mt-4">
                        <a href="/MeusPedidos" class="btn btn-primary btn-lg me-3">
                            <i class="fa-solid fa-list me-2"></i>
                            Ver Meus Pedidos
                        </a>
                        <a href="/" class="btn btn-outline-primary btn-lg">
                            <i class="fa-solid fa-shopping-cart me-2"></i>
                            Continuar Comprando
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>