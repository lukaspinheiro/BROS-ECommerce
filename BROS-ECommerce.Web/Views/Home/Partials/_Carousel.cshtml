@using BROS_ECommerce.Services.ViewModel.Banner
@{
    var banners = ViewBag.Banners as List<BannerViewModel>;
}

@if (banners is null || !banners.Any())
{
    <!-- caso não tenha banners cadastrados -->
    <section class="banner-section">
        <div class="d-flex justify-content-center">
            <div class="carousel-inner rounded-5">
                <img class="w-100" src="/img/Home/Carousel/banner-default.png" />
            </div>
        </div>
    </section>
}
else
{
    <section class="banner-section">
        <div class="d-flex justify-content-center">
            <div id="carouselExampleIndicators"
                 class="carousel vert slide"
                 data-ride="carousel">

                <div class="carousel-inner rounded-5">
                    @for (int i = 0; i < banners.Count; i++)
                    {
                        var b = banners[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <a href="@b.Link" target="_blank">
                                <img class="d-block w-100"
                                     src="@b.CaminhoImagem"
                                     alt="@b.Titulo" />
                            </a>
                        </div>
                    }
                </div>

                <div class="carousel-controls">
                    <a class="carousel-control-prev"
                       href="#carouselExampleIndicators"
                       role="button"
                       data-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </a>

                    <a class="carousel-control-next"
                       href="#carouselExampleIndicators"
                       role="button"
                       data-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </a>
                </div>

                <ol class="carousel-indicators d-flex justify-content-center">
                    @for (int i = 0; i < banners.Count; i++)
                    {
                        <li data-target="#carouselExampleIndicators"
                            data-slide-to="@i"
                            class="@(i == 0 ? "active" : "")"></li>
                    }
                </ol>

            </div>
        </div>
    </section>
}
