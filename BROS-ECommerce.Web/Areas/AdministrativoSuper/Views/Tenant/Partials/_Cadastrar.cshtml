@model BROS_ECommerce.Services.ViewModel.Tenant.IndexTenantViewModel

<div class="modal fade" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" id="modal-cadastrar-tenant">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="form-cadastrar-tenant" asp-area="AdministrativoSuper" asp-controller="Tenant" asp-action="CadastrarTenant" enctype="multipart/form-data" autocomplete="off" method="post" onsubmit="desabilitarBotao()">
                @Html.AntiForgeryToken()
                <input type="hidden" id="tenant-id-edicao" name="idTenant" />

                <div class="modal-header">
                    <h5 class="modal-title">Cadastrar Loja</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div style="overflow-x:auto;">
                    <div class="modal-body">
                        <div class="form-group">
                                <div id="preview-imagens" class="mt-3 d-flex flex-wrap gap-2 justify-content-center"></div>
                            <div class="form-group">
                                <label class="control-label">Logo do Site</label>

                                <input type="file" id="LogoArquivo" name="CadastrarTenant.LogoArquivo" accept="image/*" class="d-none" />
                                 
                                <div class="input-group" onclick="document.getElementById('LogoArquivo').click()">
                                    <input type="text" id="nomes-arquivos" class="form-control" readonly placeholder="Nenhuma imagem selecionada" />
                                    <div class="input-group-btn">
                                        <button type="button" class="btn btn-default">
                                            <i class="fa fa-paperclip"></i>
                                            <span class="d-none d-sm-inline">Selecionar Logo</span>
                                        </button>
                                    </div>
                                </div>

                            </div>


                            <div class="form-group">
                                <label asp-for="@Model.CadastrarTenant.Id" class="control-label"></label>
                                <input asp-for="@Model.CadastrarTenant.Id" type="text" id="Dominio" class="form-control" required autocomplete="off" style="text-transform: unset;">
                                <span asp-validation-for="@Model.CadastrarTenant.Id" class="text-danger" maxlength="30"></span>
                                <span id="dominio-error" class="text-danger small" style="display: none;">Informe um Domínio válido e de até 30 caracteres.</span>
                            </div>

                            <div class="form-group">
                                <label asp-for="@Model.CadastrarTenant.Nome" class="control-label"></label>
                                <input asp-for="@Model.CadastrarTenant.Nome" type="text" id="Nome" class="form-control" autocomplete="off" required style="text-transform: unset;">
                                <span asp-validation-for="@Model.CadastrarTenant.Nome" class="text-danger"></span>
                                <span id="nome-error" class="text-danger small" style="display: none;">Informe um nome válido.</span>
                            </div>

                            <div class="form-group">
                                <label asp-for="@Model.CadastrarTenant.Email" class="control-label"></label>
                                <input asp-for="@Model.CadastrarTenant.Email" type="text" id="Nome" class="form-control" autocomplete="off" required style="text-transform: unset;">
                                <span asp-validation-for="@Model.CadastrarTenant.Email" class="text-danger"></span>
                                <span id="email-error" class="text-danger small" style="display: none;">Informe um Email válido.</span>
                            </div>
                            
                            <div class="form-group">
                                <label asp-for="@Model.CadastrarTenant.Telefone" class="control-label"></label>
                                <input asp-for="@Model.CadastrarTenant.Telefone" type="text" id="Nome" class="form-control" autocomplete="off" required style="text-transform: unset;">
                                <span asp-validation-for="@Model.CadastrarTenant.Telefone" class="text-danger"></span>
                                <span id="telefone-error" class="text-danger small" style="display: none;">Informe um telefone válido.</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button id="btn-disable" type="submit" class="btn btn-success">ADICIONAR</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script src="~/js/shared/desabilitar-botao-ao-realizar-submit.js"></script>