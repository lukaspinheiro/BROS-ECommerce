@model BROS_ECommerce.Services.ViewModel.Usuario.CadastrarUsuarioViewModel

<div class="modal fade" id="modal-cadastrar-usuario" tabindex="-1" role="dialog" aria-labelledby="modalCadastrarUsuarioLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="form-cadastrar-usuario"
                  asp-area="Administrativo"
                  asp-controller="Usuario"
                  asp-action="Cadastrar"
                  method="post"
                  autocomplete="off"
                  onsubmit="desabilitarBotao()">

                @Html.AntiForgeryToken()
                <input type="hidden" id="usuario-id-edicao" name="IdUser" value="" />

                <div class="modal-header">
                    <h5 class="modal-title">Cadastrar Usuário</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fechar" onclick="fecharModalCadastrar()">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div style="overflow-x:auto;">
                    <div class="modal-body">
                        <div class="form-group">
                            <label asp-for="Nome"></label>
                            <input asp-for="Nome" id="Nome" class="form-control" required maxlength="100" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Email"></label>
                            <input asp-for="Email" id="Email" type="email" class="form-control" required maxlength="100" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Cpf"></label>
                            <input asp-for="Cpf" id="Cpf" class="form-control" required maxlength="14" />
                            <span asp-validation-for="Cpf" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Nascimento"></label>
                            <input asp-for="Nascimento" id="Nascimento" type="date" class="form-control" required />
                            <span asp-validation-for="Nascimento" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Genero"></label>
                            <select asp-for="Genero" id="Genero" class="form-control" required>
                                <option value="">Selecione</option>
                                <option value="M">Masculino</option>
                                <option value="F">Feminino</option>
                                <option value="O">Outro</option>
                            </select>
                            <span asp-validation-for="Genero" class="text-danger"></span>
                        </div>

                        <div class="form-group senha-group">
                            <label asp-for="Senha"></label>
                            <input asp-for="Senha" id="Senha" type="password" class="form-control" required />
                            <span asp-validation-for="Senha" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="fecharModalCadastrar()">Cancelar</button>
                    <button id="btn-disable" disabled type="submit" class="btn btn-success">ADICIONAR</button>
                </div>
            </form>
        </div>
    </div>
</div>
