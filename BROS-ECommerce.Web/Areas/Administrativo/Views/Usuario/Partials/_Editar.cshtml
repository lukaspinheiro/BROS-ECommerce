@model BROS_ECommerce.Services.ViewModel.Usuario.EditarUsuarioViewModel

<div class="modal fade" id="modal-editar-usuario" tabindex="-1" role="dialog" aria-labelledby="modalEditarUsuarioLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="form-editar-usuario"
                  asp-area="Administrativo"
                  asp-controller="Usuario"
                  asp-action="Editar"
                  method="post"
                  autocomplete="off"
                  onsubmit="desabilitarBotao()">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdUser" id="usuario-id-edicao" />

                <div class="modal-header">
                    <h5 class="modal-title">Editar Usuário</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fechar" onclick="fecharModalEditarUsuario()">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div style="overflow-x:auto;">
                    <div class="modal-body">
                        <div class="form-group">
                            <label asp-for="Nome"></label>
                            <input asp-for="Nome" id="Nome" class="form-control" required maxlength="100" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Email"></label>
                            <input asp-for="Email" id="Email" type="email" class="form-control" required maxlength="100" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Cpf"></label>
                            <input asp-for="Cpf" id="Cpf" class="form-control" required maxlength="14" />
                            <span asp-validation-for="Cpf" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Nascimento"></label>
                            <input asp-for="Nascimento" id="Nascimento" type="date" class="form-control" required />
                            <span asp-validation-for="Nascimento" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Genero"></label>
                            <select asp-for="Genero" id="Genero" class="form-control" required>
                                <option value="">Selecione</option>
                                <option value="M">Masculino</option>
                                <option value="F">Feminino</option>
                                <option value="O">Outro</option>
                            </select>
                            <span asp-validation-for="Genero" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Ativo"></label>
                            <select asp-for="Ativo" id="Ativo" class="form-control">
                                <option value="true">Ativo</option>
                                <option value="false">Inativo</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="fecharModalEditarUsuario()">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="btn-disable" disabled>ATUALIZAR</button>
                </div>
            </form>
        </div>
    </div>
</div>
