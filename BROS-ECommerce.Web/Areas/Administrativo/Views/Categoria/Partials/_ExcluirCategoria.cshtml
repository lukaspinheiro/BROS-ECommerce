<form id="form-excluir-categoria"
      asp-area="Administrativo"
      asp-controller="Categoria"
      asp-action="ExcluirCategoria"
      method="post">

    @Html.AntiForgeryToken()
    <input type="hidden" name="IdCategoria" id="input-id-exclusao" />

    <div class="modal fade" id="modal-confirmar-exclusao" tabindex="-1" role="dialog" aria-labelledby="modalExclusaoLabel" aria-hidden="true">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalExclusaoLabel">Confirmar Exclusão</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" onclick="fecharModalExclusao()">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body text-center">
                    <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
                    <p>Tem certeza que deseja excluir esta categoria?</p>
                    <p class="font-weight-bold" id="categoria-excluir-nome"></p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="fecharModalExclusao()">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="btn-confirmar-exclusao">Sim, Excluir</button>
                </div>
            </div>
        </div>
    </div>
</form>
