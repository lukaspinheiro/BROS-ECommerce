@model BROS_ECommerce.Services.ViewModel.Categoria.CadastrarCategoriaViewModel

<div class="modal fade" tabindex="-1" id="modal-cadastrar-categoria" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="form-cadastrar-categoria"
                  asp-area="Administrativo"
                  asp-controller="Categoria"
                  asp-action="CadastrarCategoria"
                  method="post"
                  autocomplete="off"
                  onsubmit="desabilitarBotao()">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Cadastrar Categoria</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>

                <div class="modal-body">
                    <div class="form-group">
                        <label asp-for="NomeCategoria"></label>
                        <input asp-for="NomeCategoria" name="cadastrarCategoriaViewModel.NomeCategoria" class="form-control" id="NomeCategoriaCadastrar" required maxlength="100" />
                        <span asp-validation-for="NomeCategoria" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Descricao"></label>
                        <textarea asp-for="Descricao" name="cadastrarCategoriaViewModel.Descricao" class="form-control" id="DescCategoriaCadastrar" rows="3" required maxlength="255"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button id="btn-disable" disabled type="submit" class="btn btn-success">Cadastrar</button>
                </div>
            </form>
        </div>
    </div>
</div>
