@model BROS_ECommerce.Services.ViewModel.Estoque.IndexEstoqueViewModel
@{
    ViewData["Title"] = "Gerenciar Estoque";
}
@section Head {
    <link href="~/lib/DataTables/datatables.min.css" rel="stylesheet">
    <style>
        .custom-select-with-image option {
            padding-left: 30px;
            background-repeat: no-repeat;
            background-size: 20px 20px;
            background-position: 5px center;
        }

            .custom-select-with-image option.with-image {
                padding-left: 35px !important;
            }
    </style>
}

<partial name="PartialsLayout/_AlertasTempData" />

<div class="container">
    <div class="card mt-0">
        <div class="card-body">
            <div class="row">
                <div class="col-12 mt-3" style="display: flex; justify-content: space-between; align-items: center;">
                    <a asp-area="Administrativo" asp-controller="Home" asp-action="Index" class="pull-left"><i class="fa-solid fa-arrow-left fa-xl" style="color: #FF4E4E;"></i></a>
                    <div>
                        <a class="btn btn-success pull-right text-white" data-toggle="modal" data-target="#modal-cadastrar-produto-no-estoque" id="btn-abrir-modal">
                            <i class="fa fa-plus"></i> Adicionar Produto
                        </a>
                    </div>
                </div>
                <div class="col-12">
                    <h3 class="title text-center"> @ViewData["Title"]</h3>

                    <div class="col-12" id="tabela-partial">
                        <partial name="Partials\_TabelaEstoque" model="Model.Tabela" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="Partials/_CadastrarNoEstoque" model="Model" />
<partial name="Partials/_AlterarEstoque" />


@section Scripts {
    <script src="~/lib/DataTables/datatables.min.js"></script>
    <script type="module" src="~/js/Administrativo/Estoque/estoque.main.js"></script>
    <script type="module" src="~/js/shared/temp-data.js"></script>
}