<div class="modal fade" id="modal-detalhes-produto" tabindex="-1" role="dialog" aria-labelledby="modalDetalhesLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDetalhesLabel">Detalhes do Produto</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="fecharModalDetalhes()">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <strong>Nome:</strong> <span id="detalhe-nome"></span>
                    </div>
                    <div class="col-12 mt-2">
                        <strong>Slug:</strong> <span id="detalhe-slug"></span>
                    </div>
                    <div class="col-12 mt-2">
                        <strong>Título da Descrição:</strong> <span id="detalhe-titulo"></span>
                    </div>
                    <div class="col-12 mt-2">
                        <strong>Descrição:</strong> <span id="detalhe-descricao"></span>
                    </div>
                    <div class="col-12 mt-2">
                        <strong>Preço:</strong> <span id="detalhe-preco" class="text-success font-weight-bold"></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="fecharModalDetalhes()">Fechar</button>
            </div>
        </div>
    </div>
</div>