@model BROS_ECommerce.Services.ViewModel.Produto.IndexProdutoViewModel

<div class="modal fade" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" id="modal-cadastrar-produto">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="form-cadastrar-produto" asp-area="Administrativo" asp-controller="Produto" asp-action="CadastrarProduto" enctype="multipart/form-data" autocomplete="off" method="post" onsubmit="desabilitarBotao()">
                @Html.AntiForgeryToken()
                <input type="hidden" id="produto-id-edicao" name="id" />

                <div class="modal-header">
                    <h5 class="modal-title">Cadastrar Produto</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="fecharModalCadastrar()">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div style="overflow-x:auto;">
                    <div class="modal-body">
                        <div class="form-group">

                            <div class="form-group">
                                <label class="control-label">Imagens do Produto</label>
                                <input type="file" id="Imagens" name="cadastrarProdutoViewModel.Arquivos" accept="image/*" class="d-none" multiple onchange="adicionarImagens(this.files)" />

                                <div class="input-group" onclick="document.getElementById('Imagens').click()">
                                    <input type="text" id="nomes-arquivos" class="form-control" readonly placeholder="Nenhuma imagem selecionada" />
                                    <div class="input-group-btn">
                                        <button type="button" class="btn btn-default">
                                            <i class="fa fa-paperclip"></i> <span class="d-none d-sm-inline">Adicionar Imagens</span>
                                        </button>
                                    </div>
                                </div>

                                <input type="hidden" name="cadastrarProdutoViewModel.IndiceImagemPrincipal" id="IndiceImagemPrincipal" />

                                <small class="form-text text-muted">Clique na imagem para defini-la como capa.</small>

                                <span id="imagem-principal-error" class="text-danger" style="display:none; font-size: 0.875em;">
                                    Por favor, selecione uma imagem principal.
                                </span>
                                <div id="preview-imagens" class="mt-3 d-flex flex-wrap gap-2"></div>
                            </div>



                            <div class="form-group">
                                <label asp-for="@Model.cadastrarProdutoViewModel.Nome" class="control-label"></label>
                                <input asp-for="@Model.cadastrarProdutoViewModel.Nome" type="text" id="Nome" class="form-control" autocomplete="off" required maxlength="50" style="text-transform: unset;">
                                <span asp-validation-for="@Model.cadastrarProdutoViewModel.Nome" class="text-danger"></span>
                                <span id="nome-error" class="text-danger small" style="display: none;">Informe um Nome válido, sem espaços em branco e de até 50 caracteres.</span>
                            </div>

                            <div class="form-group">
                                <label asp-for="@Model.cadastrarProdutoViewModel.Slug" class="control-label"></label>
                                <input asp-for="@Model.cadastrarProdutoViewModel.Slug" type="text" id="Slug" class="form-control" autocomplete="off" required maxlength="30" style="text-transform: unset;">
                                <span asp-validation-for="@Model.cadastrarProdutoViewModel.Slug" class="text-danger"></span>
                                <span id="slug-error" class="text-danger small" style="display: none;">Informe um Caminho URL válido, sem espaços em branco e de até 30 caracteres.</span>
                            </div>

                            <div class="form-group">
                                <label asp-for="@Model.cadastrarProdutoViewModel.TituloDescricao" class="control-label"></label>
                                <input asp-for="@Model.cadastrarProdutoViewModel.TituloDescricao" type="text" id="TituloDescricao" class="form-control" autocomplete="off" required maxlength="50" style="text-transform: unset;">
                                <span asp-validation-for="@Model.cadastrarProdutoViewModel.TituloDescricao" class="text-danger"></span>
                                <span id="titulo-error" class="text-danger small" style="display: none;">Informe um título de descrição válido, sem espaços em branco e de até 50 caracteres.</span>
                            </div>

                            <div class="form-group">
                                <label asp-for="@Model.cadastrarProdutoViewModel.Descricao" class="control-label"></label>
                                <input asp-for="@Model.cadastrarProdutoViewModel.Descricao" type="text" id="Descricao" class="form-control" autocomplete="off" required maxlength="300" style="text-transform: unset;">
                                <span asp-validation-for="@Model.cadastrarProdutoViewModel.Descricao" class="text-danger"></span>
                                <span id="descricao-error" class="text-danger small" style="display: none;">Informe uma descrição válida, sem espaços em branco e de até 300 caracteres.</span>
                            </div>

                            <div class="form-group">
                                <label asp-for="@Model.cadastrarProdutoViewModel.Preco" class="control-label"></label>
                                <input asp-for="@Model.cadastrarProdutoViewModel.Preco" type="number" step="0.01" id="Preco" class="form-control" autocomplete="off" required style="text-transform: unset;">
                                <span asp-validation-for="@Model.cadastrarProdutoViewModel.Preco" class="text-danger"></span>
                                <span id="preco-error" class="text-danger small" style="display: none;">Informe um valor válido.</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="fecharModalCadastrar()">Cancelar</button>
                    <button id="btn-disable" disabled="true" type="submit" class="btn btn-success">ADICIONAR</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script src="~/js/shared/desabilitar-botao-ao-realizar-submit.js"></script>