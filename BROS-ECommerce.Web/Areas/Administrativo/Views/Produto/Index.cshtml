@model BROS_ECommerce.Services.ViewModel.Produto.IndexProdutoViewModel

@{
    ViewData["Title"] = "Gerenciar Produtos";
}

@section Head {
    <link href="~/lib/DataTables/datatables.min.css" rel="stylesheet">
}
<div>
    <p>testei</p>
    <partial name="Partials/_Cadastrar" />

</div>

<div class="container">
    <div class="card mt-0">
        <div class="card-body">
            <div class="row">
                <div class="col-12 mt-3" style="display: flex; justify-content: space-between; align-items: center;">
                    <a href="javascript:history.back()" class="pull-left"><i class="fa-solid fa-arrow-left fa-xl" style="color: #FF4E4E;"></i></a>
                    <a class="btn btn-success pull-right text-white" data-toggle="modal" data-target="#modal-cadastrar-produto"> <i class="fa fa-plus"></i>Cadastrar</a>
                </div>

                <div class="col-12">
                    <h3 class="title text-center"> @ViewData["Title"]</h3>
                    
                    <div class="col-12" id="tabela-partial">
                        <partial name="Partials\_TabelaProduto" @* model="Model.Tabela" *@ />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>





@section Scripts {
    <script src="~/lib/DataTables/datatables.min.js"></script>
    <script>
        function verificarEspacos(input) {
            var titulo = document.getElementById("Titulo");
            var descricao = document.getElementById("Descricao");

            if (/^\s*$/.test(descricao.value) || /^\s*$/.test(descricao.value)) {
                document.getElementById('btn-disable').disabled = true;
            } else {
                document.getElementById('btn-disable').disabled = false;
            }

            var errorElement;
            if (input.id === "Titulo") {
                errorElement = document.getElementById("titulo-error");
            } else if (input.id === "Descricao") {
                errorElement = document.getElementById("descricao-error");
            }

            if (/^\s*$/.test(input.value)) {
                errorElement.style.display = "block";
            } else {
                errorElement.style.display = "none";
            }
        }
    </script>
}