@model BROS_ECommerce.Services.ViewModel.Produto.IndexProdutoViewModel

@{
    ViewData["Title"] = "Gerenciar Produtos";
}
@section Head {
    <partial name="Css\_datatables" />
    <link rel="stylesheet" type="text/css" href="~/css/Administrativo/Produto/produto.css" />
    <link rel="stylesheet" type="text/css" href="~/css/Administrativo/Produto/produto.modal.css"/>
}

<partial name="PartialsLayout/_AlertasTempData" />
<script>
    console.log("TempData renderizado");
</script>


<div class="container">
    <div class="card mt-0">
        <div class="card-body">
            <div class="row">
                <div class="col-12 mt-3" style="display: flex; justify-content: space-between; align-items: center;">
                    <a asp-area="Administrativo" asp-controller="Home" asp-action="Index" class="pull-left"><i class="fa-solid fa-arrow-left fa-xl" style="color: #535353"></i></a>
                    <div>
                        <a class="btn btn-success pull-right text-white" data-toggle="modal" data-target="#modal-cadastrar-produto" id="btn-abrir-modal">
                            <i class="fa fa-plus"></i> Cadastrar
                        </a>
                    </div>
                </div>
                <div class="col-12">
                    <h3 class="title text-center"> @ViewData["Title"]</h3>

                    <div class="col-12" id="tabela-partial">
                        <partial name="Partials\_TabelaProduto" model="Model.Tabela" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="Partials/_Cadastrar" />
<partial name="Partials/_ModalDetalhesProduto">
<partial name="Partials/_ModalExclusaoProduto">
<div id="div-modal-categorias"></div>


@section Scripts {
    <partial name="Script\_datatables" />
    <script type="module" src="~/js/Administrativo/Produto/produto.main.js"></script>
    <script type="module" src="~/js/shared/temp-data.js"></script>
    <script type="text/javascript" src="~/js/Administrativo/Produto/produto.categorias.js"></script>
}