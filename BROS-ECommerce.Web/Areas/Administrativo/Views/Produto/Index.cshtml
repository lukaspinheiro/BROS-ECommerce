@{
    ViewData["Title"] = "Gerenciar Produtos";
}

@section Head {
    <partial name="Css\_datatables" />
    <partial name="Css\_bootstrap-select" />
}

<div class="container">
    <div class="card mt-0">
        <div class="card-body">
            <div class="row">
                <div class="col-12 mt-3" style="display: flex; justify-content: space-between; align-items: center;">
                    <a href="javascript:history.back()" class="pull-left"><i class="fa-solid fa-arrow-left fa-xl" style="color: #FF4E4E;"></i></a>
                    <a class="btn btn-primary pull-right text-white" data-toggle="modal" data-target="#modal-adicionar-anexo"> <i class="fa fa-plus"></i>Adicionar</a>
                </div>

                <div class="col-12">
                    <h3 class="title"> @ViewData["Title"]</h3>

                    <div class="col-12" id="tabela-partial">
                        <partial name="Partials\_TabelaProduto" @* model="Model.Tabela" *@ />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="Script\_datatables" />
    <partial name="Script\_bootstrap-select" />
}