@model BROS_ECommerce.Services.ViewModel.Imagem.IndexImagemViewModel

@{
    ViewData["Title"] = "Gerenciar Imagens";
}

@section Head {
    <style>
        .imagem-card {
            border: 1px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
            transition: transform 0.2s;
            height: 100%;
        }

            .imagem-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            }

        .imagem-preview {
            width: 100%;
            height: 200px;
            object-fit: cover;
            background: #f8f9fa;
        }

        .imagem-info {
            padding: 10px;
            background: #f8f9fa;
        }

        .upload-area {
            border: 2px dashed #ccc;
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            background: #f8f9fa;
            margin-bottom: 20px;
        }

            .upload-area.dragover {
                border-color: #007bff;
                background: #e3f2fd;
            }

        .grid-imagens {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .estatisticas {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
    </style>
}



@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


<div class="card mb-4">

    <div class="card-body">
        <div class="row">
            <div class="col-12 mt-3" style="display: flex; justify-content: space-between; align-items: center;">
                <a asp-area="Administrativo" asp-controller="Home" asp-action="Index" class="pull-left pl-2"><i class="fa-solid fa-arrow-left fa-xl" style="color: #535353;"></i></a>
                <div>
                    <span class="badge badge-info">@Model.TotalItens imagens</span>
                    <span class="badge badge-secondary">@Model.TamanhoTotalFormatado</span>
                </div>
            </div>
            <div class="col-12">
                <h3 class="title text-center"> @ViewData["Title"]</h3>
            </div>
        </div>
    </div>

    <div class="card-header">
        <h5><i class="fas fa-upload"></i> Fazer Upload de Imagens</h5>
    </div>
    <div class="card-body">
        <form asp-action="Upload" method="post" enctype="multipart/form-data">
            <div class="upload-area" id="uploadArea">
                <i class="fas fa-cloud-upload-alt fa-2x text-muted mb-2"></i>
                <p>Arraste e solte imagens aqui ou clique para selecionar</p>
                <input type="file" asp-for="CadastrarImagem.Arquivos" multiple accept="image/*" class="form-control-file d-none" id="fileInput">
                <button type="button" class="btn btn-outline-primary" onclick="document.getElementById('fileInput').click()">
                    <i class="fas fa-folder-open"></i> Selecionar Arquivos
                </button>
            </div>

            <div class="form-group mt-3">
                <label asp-for="CadastrarImagem.AltText">Texto Alternativo (opcional)</label>
                <input asp-for="CadastrarImagem.AltText" class="form-control" placeholder="Descrição da imagem para acessibilidade">
            </div>

            <div id="previewContainer" class="mt-3" style="display: none;">
                <h6>Arquivos Selecionados:</h6>
                <div id="previews" class="d-flex flex-wrap gap-2"></div>
            </div>

            <button type="submit" class="btn btn-success mt-3">
                <i class="fas fa-upload"></i> Fazer Upload
            </button>
        </form>
    </div>
</div>


@if (Model.Imagens.Any())
{
    <div class="grid-imagens">
        @foreach (var imagem in Model.Imagens)
        {
            <div class="imagem-card">
                <img src="@imagem.CaminhoArquivo" alt="@imagem.AltText" class="imagem-preview"
                     onclick="visualizarImagem('@imagem.CaminhoArquivo', '@imagem.NomeArquivo')">

                <div class="imagem-info">
                    <h6 class="mb-1">@imagem.NomeArquivo</h6>
                    <small class="text-muted">
                        @imagem.TamanhoFormatado • @imagem.DataCriacao.ToString("dd/MM/yyyy")
                    </small>

                    @if (imagem.QuantidadeProdutos > 0)
                    {
                        <div class="mt-2">
                            <span class="badge badge-info">@imagem.QuantidadeProdutos produto(s)</span>
                        </div>
                    }

                    <div class="mt-2">
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                onclick="visualizarImagem('@imagem.CaminhoArquivo', '@imagem.NomeArquivo')">
                            <i class="fas fa-eye"></i>
                        </button>

                        <a href="@Url.Action("Detalhes", new { id = imagem.IdImagem })" class="btn btn-sm btn-outline-info">
                            <i class="fas fa-info-circle"></i>
                        </a>

                        <button type="button" class="btn btn-sm btn-outline-danger"
                                onclick="confirmarExclusao('@imagem.IdImagem', '@imagem.NomeArquivo')">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    
    @if (Model.TotalPaginas > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @if (Model.PaginaAtual > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { pagina = Model.PaginaAtual - 1 })">Anterior</a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaAtual ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { pagina = i })">@i</a>
                    </li>
                }

                @if (Model.PaginaAtual < Model.TotalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { pagina = Model.PaginaAtual + 1 })">Próxima</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-images fa-4x text-muted mb-3"></i>
        <h4>Nenhuma imagem encontrada</h4>
        <p class="text-muted">Faça upload de imagens para começar a usar no seus produtos</p>
    </div>
}


<div class="modal fade" id="modalVisualizacao" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalImagemTitulo"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImagemPreview" class="img-fluid" style="max-height: 500px;">
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modalConfirmacao" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Exclusão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Tem certeza que deseja excluir a imagem <strong id="imagemNome"></strong>?</p>
                <p class="text-danger"><small>Esta ação não pode ser desfeita.</small></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formExclusao" method="post" class="d-inline">
                    <button type="submit" class="btn btn-danger">Excluir</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        
        const uploadArea = document.getElementById('uploadArea');
        const fileInput = document.getElementById('fileInput');
        const previewContainer = document.getElementById('previewContainer');
        const previews = document.getElementById('previews');

        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.classList.add('dragover');
        });

        uploadArea.addEventListener('dragleave', () => {
            uploadArea.classList.remove('dragover');
        });

        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.classList.remove('dragover');

            const files = e.dataTransfer.files;
            fileInput.files = files;
            mostrarPreviews(files);
        });

        fileInput.addEventListener('change', (e) => {
            mostrarPreviews(e.target.files);
        });

        function mostrarPreviews(files) {
            if (files.length > 0) {
                previewContainer.style.display = 'block';
                previews.innerHTML = '';

                Array.from(files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const preview = document.createElement('div');
                        preview.className = 'text-center';
                        preview.innerHTML = `
                            <img src="${e.target.result}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 4px;">
                            <small class="d-block text-muted">${file.name}</small>
                        `;
                        previews.appendChild(preview);
                    };
                    reader.readAsDataURL(file);
                });
            } else {
                previewContainer.style.display = 'none';
            }
        }

        function visualizarImagem(caminho, nome) {
            document.getElementById('modalImagemTitulo').textContent = nome;
            document.getElementById('modalImagemPreview').src = caminho;
            new bootstrap.Modal(document.getElementById('modalVisualizacao')).show();
        }

        function confirmarExclusao(id, nome) {
            document.getElementById('imagemNome').textContent = nome;
            document.getElementById('formExclusao').action = '@Url.Action("Excluir")/' + id;
            new bootstrap.Modal(document.getElementById('modalConfirmacao')).show();
        }
    </script>
}