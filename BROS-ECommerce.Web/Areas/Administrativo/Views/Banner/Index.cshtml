@using BROS_ECommerce.Services.ViewModel.Banner
@model List<BannerViewModel>

@{
    ViewData["Title"] = "Banners";
}

<div class="container">
    <div class="card mt-0">
        <div class="card-body">
            <div class="row">
                <div class="col-12 mt-3" style="display: flex; justify-content: space-between; align-items: center;">
                    <a asp-area="Administrativo" asp-controller="Home" asp-action="Index" class="pull-left"><i class="fa-solid fa-arrow-left fa-xl" style="color: #535353"></i></a>
                    <div>
                        <a class="btn btn-success pull-right text-white" data-bs-toggle="modal" data-bs-target="#modalCriarBanner">
                            <i class="fa fa-plus"></i> Adicionar Banner
                        </a>
                    </div>
                </div>
                <div class="col-12">
                    <h3 class="title text-center"> @ViewData["Title"]</h3>

                    <div class="col-12" id="tabela-partial">
                        <div class="table-responsive">
                            <table class="table table-light table-sm" id="tabela">
                                <thead>
                                    <tr>
                                        <th style="width: 15%">Imagem</th>
                                        <th>Título</th>
                                        <th style="width: 15%">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Any() && Model!=null)
                                    {
                                        @foreach (var banner in Model)
                                        {
                                            <tr>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(banner.CaminhoImagem))
                                                    {
                                                        <img src="@banner.CaminhoImagem" width="120" class="img-thumbnail" />
                                                    }
                                                </td>
                                                <td>@banner.Titulo</td>
                                                <td>
                                                    <div class="btn-group btn-group-sm gap-1" role="group">
                                                        <button class="btn btn-sm bg-white text-success" onclick="carregarEditar('@banner.IdBanner')">
                                                            <i class="fas fa-edit fa-lg"></i>Editar
                                                        </button>
                                                        <button class="btn btn-sm bg-white text-danger" onclick="carregarExcluir('@banner.IdBanner')">
                                                            <i class="fas fa-trash-alt fa-lg" style="color: #dc3545;"></i>Excluir
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-4">
                                                <div class="text-muted">
                                                    <i class="fas fa-inbox fa-2x mb-2"></i>
                                                    <br>
                                                    <strong>Nenhum banner encontrado</strong>
                                                    <br>
                                                    <small>Adicione um banner para começar primeiro.</small>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL ADICIONAR-->
<div class="modal fade" id="modalCriarBanner" tabindex="-1" aria-labelledby="modalCriarBannerLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalCriarBannerLabel">Adicionar Banner <strong>(1350x350px)</strong></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @await Html.PartialAsync("Partials/_CriarBanner", new CriarBannerViewModel())
            </div>

        </div>
    </div>
</div>

<!-- MODAL EDITAR -->
<div class="modal fade" id="modalEditarBanner" tabindex="-1" aria-labelledby="modalEditarBannerLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalEditarBannerLabel">Editar Banner</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="conteudoEditarBanner">
                <!-- Conteúdo carregado por AJAX -->
            </div>

        </div>
    </div>
</div>

<!-- MODAL EXCLUIR -->
<div class="modal fade" id="modalExcluirBanner" tabindex="-1" aria-labelledby="modalExcluirBannerLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalExcluirBannerLabel">Excluir Banner</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="conteudoExcluirBanner">
                <!-- Conteúdo carregado por AJAX -->
            </div>

        </div>
    </div>
</div>

<script>
    function carregarEditar(id) {
        $.get('/Administrativo/Banner/Edit/' + id, function (data) {
            $("#conteudoEditarBanner").html(data);
            $("#modalEditarBanner").modal('show');
        });
    }

    function carregarExcluir(id) {
        $.get('/Administrativo/Banner/Delete/' + id, function (data) {
            $("#conteudoExcluirBanner").html(data);
            $("#modalExcluirBanner").modal('show');
        });
    }
    
    function salvarEdicaoBanner(id) {
        const form = document.getElementById("formEditarBanner");
        const formData = new FormData(form);

        fetch('/Administrativo/Banner/Edit/' + id, {
            method: 'POST',
            body: formData
        })
        .then(r => {
            if (r.redirected) {
                window.location.href = r.url;
            } else {
                $("#conteudoEditarBanner").html(r);
            }
        });
    }
</script>
