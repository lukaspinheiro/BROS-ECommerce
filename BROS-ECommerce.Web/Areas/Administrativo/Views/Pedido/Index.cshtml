@using BROS_ECommerce.Services.ViewModel.Pedido
@model IndexPedidoViewModel

@{
    ViewData["Title"] = "Gerenciar Pedidos";
}

@section Head {
    <link rel="stylesheet" type="text/css" href="/css/Administrativo/tabela.css" />
    <link rel="stylesheet" type="text/css" href="/css/Administrativo/estatisticas.css" />
    <link rel="stylesheet" type="text/css" href="/css/Administrativo/Pedido/Pedido.css" />
}

<div class="container">
    <div class="card mt-0">
        <div class="card-body">
            <div class="row">
                <div class="col-12 mt-3">
                    <a href="javascript:history.back()" class="pull-left">
                        <i class="fa-solid fa-arrow-left fa-xl" style="color: #FF4E4E;"></i>
                    </a>
                </div>

                <div class="col-12 text-center">
                    <h3 class="title">@ViewData["Title"]</h3>
                </div>

                <div class="col-12 mt-4">
                    <div class="row">
                        <div class="col-md-3 col-sm-6 mb-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6 class="card-title">Total de Pedidos</h6>
                                            <h3>@Model.TotalPedidos</h3>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fa-solid fa-shopping-cart fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 col-sm-6 mb-3">
                            <div class="card bg-warning text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6 class="card-title">Pendentes</h6>
                                            <h3>@Model.PedidosPendentes</h3>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fa-solid fa-clock fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 col-sm-6 mb-3">
                            <div class="card bg-success text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6 class="card-title">Entregues</h6>
                                            <h3>@Model.PedidosEntregues</h3>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fa-solid fa-truck fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 col-sm-6 mb-3">
                            <div class="card bg-info text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6 class="card-title">Valor Total</h6>
                                            <h3>@Model.ValorTotalPedidos.ToString("C")</h3>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fa-solid fa-dollar-sign fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 mt-4">
                    <div class="card">
                        <div class="card-header">
                            <h5>Filtros de Pesquisa</h5>
                        </div>
                        <div class="card-body">
                            <form method="post" asp-action="Filtrar">
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label asp-for="Filtro.NumeroPedido">Número do Pedido</label>
                                            <input asp-for="Filtro.NumeroPedido" class="form-control" placeholder="Ex: P-0001" />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label asp-for="Filtro.Status">Status</label>
                                            <select asp-for="Filtro.Status" class="form-control">
                                                <option value="">Todos</option>
                                                <option value="Pendente">Pendente</option>
                                                <option value="Confirmado">Confirmado</option>
                                                <option value="Processando">Processando</option>
                                                <option value="Enviado">Enviado</option>
                                                <option value="Entregue">Entregue</option>
                                                <option value="Cancelado">Cancelado</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label asp-for="Filtro.NomeCliente">Nome do Cliente</label>
                                            <input asp-for="Filtro.NomeCliente" class="form-control" placeholder="Digite o nome" />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label asp-for="Filtro.DataInicio">Data Início</label>
                                            <input asp-for="Filtro.DataInicio" type="date" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label asp-for="Filtro.DataFim">Data Fim</label>
                                            <input asp-for="Filtro.DataFim" type="date" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="col-md-9">
                                        <div class="form-group d-flex align-items-end">
                                            <button type="submit" class="btn btn-primary me-2">
                                                <i class="fa-solid fa-filter"></i> Filtrar
                                            </button>
                                            <a asp-action="Index" class="btn btn-secondary">
                                                <i class="fa-solid fa-refresh"></i> Limpar
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-12 mt-4">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5>Lista de Pedidos</h5>
                            <div>
                                <span class="badge bg-primary">@Model.TotalPedidos Pedidos</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <partial name="Partials/_TabelaPedidos" model="@Model.Tabela" />
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="~/js/Administrativo/Pedido/pedido.js"></script>
}