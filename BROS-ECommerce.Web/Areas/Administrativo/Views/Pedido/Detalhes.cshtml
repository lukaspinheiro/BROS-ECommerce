@using System.Globalization
@using BROS_ECommerce.Services.ViewModel.Pedido
@model DetalhesPedidoViewModel

@{
    ViewData["Title"] = $"Detalhes do Pedido {Model.NumeroPedido}";
}

@section Head {
    <link rel="stylesheet" href="/css/MeusPedidos/meus-pedidos.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
          integrity="sha512‑Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />
}

<div class="container mt-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/MeusPedidos">Meus Pedidos</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.NumeroPedido</li>
        </ol>
    </nav>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-check-circle me-2"></i>@TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-exclamation-triangle me-2"></i>@TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0">
                    <i class="fa-solid fa-shopping-bag me-2"></i>Pedido @Model.NumeroPedido
                </h4>
                <small class="text-muted">Realizado em @Model.DataPedidoFormatada</small>
            </div>
            <span class="badge bg-@Model.StatusCor fs-6">
                @Model.StatusFormatado
            </span>
        </div>

        <div class="card-body">
            <div class="row">
                <!-- Itens do Pedido -->
                <div class="col-md-8">
                    <h5 class="mb-3">
                        <i class="fa-solid fa-list me-2"></i>
                        Itens do Pedido (@Model.Itens.Count)
                    </h5>
                    <div class="table-responsive">
                        <table class="table table-hover table-striped table-borderless align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Produto</th>
                                    <th>Qtd.</th>
                                    <th>Preço Unit.</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Itens)
                                {
                                    <tr>
                                        <td><strong>@item.NomeProduto</strong></td>
                                        <td>@item.Quantidade</td>
                                        <td>
                                            @item.PrecoUnitario.ToString("C2",
                                            CultureInfo.GetCultureInfo("pt-BR"))
                                    </td>
                                    <td class="text-end fw-bold">
                                        @item.ValorTotal.ToString("C2",
                                                                                CultureInfo.GetCultureInfo("pt-BR"))
                                    </td>
                                </tr>
                                                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Resumo do Pedido -->
                <div class="col-md-4">
                    <div class="card bg-light mb-3">
                        <div class="card-body p-0">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Subtotal</span>
                                    <span>
                                        @Model.ValorSubtotal.ToString("C2",
                                        CultureInfo.GetCultureInfo("pt-BR"))
                                    </span>
                                </li>
                                @if (Model.ValorDesconto > 0)
                                {
                                    <li class="list-group-item d-flex justify-content-between text-success">
                                        <span>Desconto</span>
                                        <span>
                                            -@Model.ValorDesconto.ToString("C2",
                                                                                    CultureInfo.GetCultureInfo("pt-BR"))
                                    </span>
                                </li>
                                                                }
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Frete</span>
                                    <span>
                                        @Model.ValorFrete.ToString("C2",
                                        CultureInfo.GetCultureInfo("pt-BR"))
                                    </span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between fw-bold">
                                    <span>Total</span>
                                    <span>
                                        @Model.ValorTotal.ToString("C2",
                                                                                CultureInfo.GetCultureInfo("pt-BR"))
                                    </span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    @if (Model.Status == "Pendente" || Model.Status == "Confirmado")
                    {
                        <button type="button"
                                class="btn btn-outline-danger w-100 cancelar-pedido mb-3"
                                data-id="@Model.IdPedido"
                                data-numero="@Model.NumeroPedido">
                            <i class="fa-solid fa-times me-2"></i>Cancelar Pedido
                        </button>
                    }
                </div>
            </div>

            <!-- Observações -->
            @if (!string.IsNullOrEmpty(Model.ObservacoesPedido))
            {
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <div class="observacoes-titulo">
                                    <i class="fa-solid fa-comment-dots me-2"></i>Observações do Pedido
                                </div>
                                <div class="observacoes-container">
                                    <p class="observacoes-texto">@Model.ObservacoesPedido</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Informações de Cancelamento -->
            @if (Model.DataCancelamento.HasValue)
            {
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="alert alert-danger">
                            <h6><i class="fa-solid fa-ban me-2"></i>Informações do Cancelamento</h6>
                            <p class="mb-1">
                                <strong>Data:</strong>
                                @Model.DataCancelamento.Value.ToString("dd/MM/yyyy HH:mm")
                            </p>
                            @if (!string.IsNullOrEmpty(Model.MotivoCancelamento))
                            {
                                <p class="mb-0">
                                    <strong>Motivo:</strong> @Model.MotivoCancelamento
                                </p>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Ações -->
            <div class="row mt-4">
                <div class="col-12 d-flex justify-content-between gap-2">
                    <a href="/MeusPedidos" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left me-2"></i>Voltar para Meus Pedidos
                    </a>
                    <a href="/" class="btn btn-outline-primary">
                        <i class="fa-solid fa-shopping-cart me-2"></i>Continuar Comprando
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Cancelamento -->
<div class="modal fade" id="modalCancelarPedido" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cancelar Pedido</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>
                    Tem certeza que deseja cancelar o pedido
                    <strong id="numeroPedidoCancelar"></strong>?
                </p>
                <textarea id="motivoCancelamento"
                          class="form-control"
                          rows="3"
                          placeholder="Descreva o motivo..."
                          required></textarea>
            </div>
            <div class="modal-footer d-flex gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Voltar</button>
                <form method="post" class="m-0 p-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="idPedidoCancelar" name="idPedido" />
                    <input type="hidden" id="motivoCancelamentoHidden" name="motivoCancelamento" />
                    <button type="submit"
                            class="btn btn-danger"
                            formaction="@Url.Action("CancelarPedido", "MeusPedidos")">
                        Confirmar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.cancelar-pedido').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.getElementById('idPedidoCancelar').value = btn.dataset.id;
                    document.getElementById('numeroPedidoCancelar').textContent = btn.dataset.numero;
                    new bootstrap.Modal('#modalCancelarPedido').show();
                });
            });
            document.querySelector('#modalCancelarPedido form')
                    .addEventListener('submit', e => {
                const mot = document.getElementById('motivoCancelamento').value.trim();
                if (!mot) {
                    e.preventDefault();
                    alert('Por favor, informe o motivo.');
                } else {
                    document.getElementById('motivoCancelamentoHidden').value = mot;
                }
            });
        });
    </script>
}
